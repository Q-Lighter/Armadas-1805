{
  "name": "armadas-1805",
  "version": "0.0.0",
  "private": true,
  "description": "A browser-based 1805 naval strategy game.",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build-map": "esbuild scripts/build-map.ts --bundle --platform=node --format=esm --target=node20 --outfile=.map-build/build-map.mjs && node .map-build/build-map.mjs",
    "measure-map": "node scripts/measure-map.mjs",
    "benchmark:world": "node scripts/benchmark-world.mjs",
    "benchmark:fleets": "node scripts/benchmark-fleets.mjs",
    "test": "node scripts/test.mjs",
    "test:server": "npm run build && node scripts/simulate-clients.mjs",
    "deploy": "wrangler deploy",
    "benchmark:battle": "node scripts/benchmark-battle.mjs",
    "benchmark:battle-zone": "node scripts/benchmark-battle-zone.mjs",
    "benchmark:3d": "node scripts/benchmark-3d.mjs",
    "test:e2e": "npx tsc -p shared/tsconfig.json && npx tsc -p server/tsconfig.json && node tests/harness/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^22.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.0",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.156.1",
    "ws": "^8.22.1"
  }
}
