{
  // Cloudflare settings for Armada's 1805.
  // The Worker runs the game rooms and serves the built page in dist/.
  "name": "armadas-1805",
  "main": "server/dist/worker.js",
  "compatibility_date": "2026-11-02",

  // Static page from `npm run build`. The Worker serves it for every path
  // except /ws.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Let the Worker add no-cache headers to index.html and version.json.
    // Without this, Cloudflare serves matching static files first.
    "run_worker_first": true
  },

  // One Durable Object per room code, holding that room's world.
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },

  // Free plans require SQLite-backed Durable Object classes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
